GROQ_API_KEY=your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
# DATA_DIR=./data

# Chroma server shared by the API and the RQ worker (required when using Contribute).
# `python dev.py` starts it (with the worker and API). Manual: chroma run --path data/chroma_db --port 8001
# Port 8001, not 8000: the API uses 8000.
CHROMA_HOST=localhost
CHROMA_PORT=8001
